# Copy this file to backend/.env and fill in your own values (.env is ignored by Git: never commit it)

# PostgreSQL database (on Onyxia: values given when the PostgreSQL service is launched)

POSTGRES_HOST=postgresql-cnpg-<suffixe>
POSTGRES_PORT=5432
POSTGRES_DATABASE=defaultdb #(by default, change if necessary)
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>

# This schema is deleted and created again each time the database is initialized
POSTGRES_SCHEMA=projet

# SNCF API token (free): https://numerique.sncf.com/startup/api/
SNCF_API_TOKEN=<token>
